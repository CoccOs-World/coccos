# Cache et fichiers propres à la machine (jamais dans le dépôt)
.godot/
export_presets.cfg
*.tmp

# Gabarit de build Android (gradle) : seuls NOS fichiers modifiés sont
# versionnés — le reste se réinstalle via l'éditeur Godot (« Install Android
# Build Template »), puis git restaure le manifeste et l'activité.
android/*
!android/.build_version
!android/build
android/build/*
!android/build/src
android/build/src/*
!android/build/src/main
android/build/src/main/*
!android/build/src/main/AndroidManifest.xml
!android/build/src/main/java
android/build/src/main/java/**
!android/build/src/main/java/com/
!android/build/src/main/java/com/godot/
!android/build/src/main/java/com/godot/game/
!android/build/src/main/java/com/godot/game/GodotApp.java

# Voix Piper temps réel : le code source du GDExtension est versionné,
# ses artefacts binaires et le modèle de 61 Mo ne le sont pas.
bin/*.so
# Modèles de synthèse vocale (61 Mo) : jamais dans le dépôt, où qu'ils soient posés.
*.onnx
outils/piper_gdextension/.include_tiers/
outils/piper_gdextension/.sconsign.dblite
outils/piper_gdextension/**/*.o
outils/piper_gdextension/**/*.os
__pycache__/

# Voix embarquée pour Android (étape 2) : ~62 Mo d'artefacts tiers — le paquet
# sherpa `vits-piper-fr_FR-siwis-medium` (modèle, tokens.txt, espeak-ng-data
# réduit au français). Reconstituable par le README du GDExtension.
voix_android/
# Bibliothèques natives sherpa-onnx arm64 embarquées dans l'APK (26 Mo).
bin/**/*.so
# Paquets installables produits localement.
installable_android/

# Fichiers régénérés à chaque build du GDExtension (dump de l'API Godot et
# interface godot-cpp) : 7,4 Mo recréés par --dump-extension-api, jamais versionnés.
outils/piper_gdextension/extension_api.json
outils/piper_gdextension/gdextension_interface.h
outils/piper_gdextension/gdextension_interface.json
