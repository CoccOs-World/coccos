#!/usr/bin/env python
"""
Build du GDExtension PiperTTS — voix siwis femme à la volée.

DEUX CIBLES, DEUX MOTEURS, UNE SEULE RECETTE DE SON :
  scons                                  -> Linux x86_64, moteur Piper natif (historique)
  scons platform=android arch=arm64      -> Android arm64-v8a, moteur sherpa-onnx (API C)

Le chemin Linux ci-dessous est INCHANGÉ ; le chemin Android vit dans son propre
bloc, plus bas, et ne partage que les sources du pont Godot.

Voie choisie : on RÉUTILISE les bibliothèques déjà livrées par le binaire Piper
natif (libpiper_phonemize, libonnxruntime, libespeak-ng) et on ne recompile que
piper.cpp + le pont Godot. Aucun rebuild d'onnxruntime.

Les sources tierces et le modèle restent HORS du dépôt. Leurs emplacements sont
donnés par ces variables d'environnement (valeurs par défaut = poste de Fabrice) :
  GODOT_CPP        godot-cpp compilé          ~/dev/tiers/godot-cpp
  PIPER_SRC        sources rhasspy/piper      ~/dev/tiers/piper/src/cpp
  PHONEMIZE_SRC    sources piper-phonemize    ~/dev/tiers/piper-phonemize/src
  ORT_INCLUDE      en-têtes onnxruntime 1.14  /tmp/ort/onnxruntime-linux-x64-1.14.1/include
  ESPEAK_INCLUDE   dossier contenant espeak-ng/speak_lib.h
  PIPER_LIBS       dossier des .so Piper      ~/.local/opt/piper

Sortie : ../../bin/libpiper_tts.linux.<target>.x86_64.so (hors dépôt, .gitignore).
"""
import os

HOME = os.path.expanduser("~")

def chemin(var, defaut):
    return os.path.abspath(os.environ.get(var, defaut))

GODOT_CPP = chemin("GODOT_CPP", HOME + "/dev/tiers/godot-cpp")
PIPER_SRC = chemin("PIPER_SRC", HOME + "/dev/tiers/piper/src/cpp")
PHONEMIZE_SRC = chemin("PHONEMIZE_SRC", HOME + "/dev/tiers/piper-phonemize/src")
ORT_INCLUDE = chemin("ORT_INCLUDE", "/tmp/ort/onnxruntime-linux-x64-1.14.1/include")
ESPEAK_INCLUDE = chemin("ESPEAK_INCLUDE", "/tmp/espeak_include")
PIPER_LIBS = chemin("PIPER_LIBS", HOME + "/.local/opt/piper")

ICI = Dir(".").srcnode().abspath
CIBLE = ARGUMENTS.get("target", "template_debug")
PLATEFORME = ARGUMENTS.get("platform", "linux")
ARCH = ARGUMENTS.get("arch", "x86_64")

# ---------------------------------------------------------------------------
# ANDROID arm64-v8a — moteur sherpa-onnx
# ---------------------------------------------------------------------------
# Sur Android on ne compile PAS Piper : on appelle sherpa-onnx par son API C
# (libsherpa-onnx-c-api.so + libonnxruntime.so, mêmes poids siwis). Le NDK est
# utilisé directement ; godot-cpp doit avoir été bâti au préalable par
#   cd $GODOT_CPP && scons platform=android arch=arm64 target=<cible> api_version=4.7
#
#   ANDROID_HOME     SDK Android                ~/Android/Sdk
#   ANDROID_NDK_VER  version du NDK             28.1.13356709 (défaut godot-cpp)
#   ANDROID_API      niveau d'API visé          24 (défaut godot-cpp)
#   SHERPA_DIR       sherpa-onnx extrait        ~/dev/tiers/sherpa-onnx
#                    -> include/c-api.h et arm64-v8a/*.so
#
# Sortie : ../../bin/libpiper_tts.android.<target>.arm64.so (hors dépôt).
if PLATEFORME == "android":
    if ARCH != "arm64":
        raise SystemExit("Android : seule l'architecture arm64 est prévue (arch=%s demandée)." % ARCH)

    ANDROID_HOME = chemin("ANDROID_HOME", HOME + "/Android/Sdk")
    NDK_VER = os.environ.get("ANDROID_NDK_VER", "28.1.13356709")
    API = os.environ.get("ANDROID_API", "24")
    SHERPA_DIR = chemin("SHERPA_DIR", HOME + "/dev/tiers/sherpa-onnx")
    NDK = os.path.join(ANDROID_HOME, "ndk", NDK_VER)
    OUTILS = os.path.join(NDK, "toolchains", "llvm", "prebuilt", "linux-x86_64", "bin")
    CLANG = os.path.join(OUTILS, "aarch64-linux-android%s-clang++" % API)

    for besoin, ou in (("NDK", NDK), ("compilateur", CLANG),
            ("en-tête sherpa", os.path.join(SHERPA_DIR, "include", "c-api.h")),
            ("bibliothèques sherpa arm64", os.path.join(SHERPA_DIR, "arm64-v8a"))):
        if not os.path.exists(ou):
            raise SystemExit("Android : %s introuvable (%s)." % (besoin, ou))

    env = Environment(ENV=os.environ, tools=["default"], CXX=CLANG, LINK=CLANG,
            AR=os.path.join(OUTILS, "llvm-ar"), RANLIB=os.path.join(OUTILS, "llvm-ranlib"))
    env.Append(CXXFLAGS=["-std=c++17", "-O2", "-fPIC", "-fexceptions", "-fvisibility=hidden",
            "-Wno-deprecated-declarations"])
    # Le moteur sherpa au lieu de Piper : un seul interrupteur, lu par piper_tts.{h,cpp}.
    env.Append(CPPDEFINES=["COCCOS_TTS_SHERPA"])
    env.Append(CPPPATH=[
        os.path.join(ICI, "src"),
        os.path.join(SHERPA_DIR, "include"),
        os.path.join(GODOT_CPP, "include"),
        os.path.join(GODOT_CPP, "gen", "include"),
        os.path.join(GODOT_CPP, "gdextension"),
    ])
    env.Append(LIBPATH=[os.path.join(GODOT_CPP, "bin"), os.path.join(SHERPA_DIR, "arm64-v8a")])
    env.Append(LIBS=["godot-cpp.android.%s.arm64" % CIBLE, "sherpa-onnx-c-api", "onnxruntime", "log"])
    # Android résout les .so voisins tout seul (dossier natif de l'APK) : pas de
    # rpath à graver. `--no-undefined` fait du lien la VRAIE preuve — il refuse
    # de produire le .so si un symbole sherpa ne résout pas.
    # libc++ est lié en statique pour que le paquet n'ait pas à embarquer
    # libc++_shared.so en plus (la visibilité cachée évite tout conflit).
    env.Append(LINKFLAGS=["-static-libstdc++", "-Wl,--no-undefined", "-shared"])

    sortie = os.path.join(ICI, "..", "..", "bin", "libpiper_tts.android.%s.arm64.so" % CIBLE)
    bibliotheque = env.SharedLibrary(target=sortie, source=[
        os.path.join(ICI, "src", "piper_tts.cpp"),
        os.path.join(ICI, "src", "register_types.cpp"),
    ])
    Default(bibliotheque)
    Return()

# ---------------------------------------------------------------------------
# LINUX x86_64 — moteur Piper natif (chemin historique, inchangé)
# ---------------------------------------------------------------------------

# piper.hpp inclut <piper-phonemize/...> : on monte l'arborescence attendue par
# lien symbolique plutôt que de recopier les en-têtes dans le dépôt.
PONT = os.path.join(ICI, ".include_tiers")
lien = os.path.join(PONT, "piper-phonemize")
if not os.path.isdir(PONT):
    os.makedirs(PONT)
if os.path.islink(lien):
    os.remove(lien)
os.symlink(PHONEMIZE_SRC, lien)

env = Environment(ENV=os.environ, tools=["default"], CXX="g++")
env.Append(CXXFLAGS=["-std=c++17", "-O2", "-fPIC", "-fexceptions", "-Wno-deprecated-declarations"])
env.Append(CPPPATH=[
    os.path.join(ICI, "src"),
    os.path.join(ICI, "shim"),      # bouchon spdlog
    PONT,                           # piper-phonemize/*.hpp
    PIPER_SRC,                      # piper.hpp, json.hpp, utf8.h, wavfile.hpp
    ORT_INCLUDE,
    ESPEAK_INCLUDE,
    os.path.join(GODOT_CPP, "include"),
    os.path.join(GODOT_CPP, "gen", "include"),
    os.path.join(GODOT_CPP, "gdextension"),
])
env.Append(LIBPATH=[os.path.join(GODOT_CPP, "bin"), PIPER_LIBS])
env.Append(LIBS=["godot-cpp.linux.%s.x86_64" % CIBLE, "piper_phonemize", "onnxruntime", "espeak-ng"])
# Les .so de Piper vivent hors des chemins système : on grave leur emplacement.
env.Append(LINKFLAGS=["-Wl,-rpath," + PIPER_LIBS, "-Wl,-rpath,$$ORIGIN"])

sources = [
    os.path.join(ICI, "src", "piper_tts.cpp"),
    os.path.join(ICI, "src", "register_types.cpp"),
    os.path.join(PIPER_SRC, "piper.cpp"),
]

sortie = os.path.join(ICI, "..", "..", "bin", "libpiper_tts.linux.%s.x86_64.so" % CIBLE)
bibliotheque = env.SharedLibrary(target=sortie, source=sources)
Default(bibliotheque)
