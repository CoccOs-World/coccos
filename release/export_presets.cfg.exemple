; ============================================================================
;  CoccOs — préréglages d'export, COPIE DE RÉFÉRENCE
;
;  Le vrai export_presets.cfg est gitignoré : Godot le réécrit à chaque
;  ouverture de l'éditeur, et il porte des chemins et mots de passe propres
;  à chaque poste. Ce fichier-ci sert à comparer ses préréglages aux nôtres.
;
;  À vérifier en priorité sur les deux préréglages Android :
;    include_filter="lang/**,classeur/**,voix_android/**"
;  Sans voix_android/**, l'APK part SANS voix hors ligne.
;
;  Les champs keystore sont VIDÉS ici — à remplir sur son propre poste,
;  jamais dans le dépôt.
; ============================================================================
[preset.0]

name="Web"
platform="Web"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter="lang/**,classeur/**"
exclude_filter=""
export_path="../site/jeu/index.html"
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
seed=0
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

custom_template/debug=""
custom_template/release=""
variant/extensions_support=false
variant/thread_support=false
vram_texture_compression/for_desktop=true
vram_texture_compression/for_mobile=false
html/export_icon=true
html/custom_html_shell=""
html/head_include=""
html/canvas_resize_policy=2
html/focus_canvas_on_start=true
html/experimental_virtual_keyboard=false
progressive_web_app/enabled=false

